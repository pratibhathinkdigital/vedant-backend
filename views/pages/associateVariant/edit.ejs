<%- include('../../layout/header') %>

<div class="dashboard-header-banner">
    <div class="banner-welcome-text">
        <h1>Edit Associate Variant</h1>
        <p>Update variant details and sub-variants.</p>
    </div>
    <div class="banner-actions">
        <a href="/associate-variants" class="btn btn-secondary">
            <i class="fa-solid fa-arrow-left"></i> Back
        </a>
    </div>
</div>

<div class="table-container" style="max-width: 900px; margin: 20px 0;">
    <div class="section-header">
        <h3>Variant Details</h3>
    </div>

    <form action="/associate-variants/update/<%= variant.id %>" method="POST" enctype="multipart/form-data" class="form-wrapper">
        
        <div class="form-group">
            <label>Associate Category</label>
            <select name="associate_category_id" required>
                <option value="">Select Category</option>
                <% categories.forEach(cat => { %>
                    <option value="<%= cat.id %>" <%= variant.associate_category_id === cat.id ? 'selected' : '' %>>
                        <%= cat.name %>
                    </option>
                <% }) %>
            </select>
        </div>

        <div class="form-group">
            <label>Title / Variant Type</label>
            <input type="text" name="title" value="<%= variant.title %>" required>
        </div>

        <div class="form-group">
            <label>Main Image</label>
            <% if(variant.image) { %>
                <div style="margin-bottom:8px;">
                    <img src="<%= variant.image %>" height="80" style="border-radius:4px;border:1px solid #ddd;">
                </div>
            <% } %>
            <input type="file" name="image" accept="image/*">
            <small>Upload new to replace existing image.</small>
        </div>

        <div class="form-group">
            <label>Category / Brand Logo (Optional)</label>
            <% if(variant.logo) { %>
                <div style="margin-bottom:8px;">
                    <img src="<%= variant.logo %>" height="42" style="background:#f8fafc;padding:4px 10px;border-radius:6px;border:1px solid #ddd;object-fit:contain;">
                </div>
            <% } %>
            <input type="file" name="logo" accept="image/*">
            <small>Upload new to replace existing brand logo.</small>
        </div>

        <div class="form-group">
            <label>PDF Brochure (Optional)</label>
            <% if(variant.pdf) { %>
                <div style="margin-bottom:8px;">
                    <a href="<%= variant.pdf %>" target="_blank" style="color:var(--primary);text-decoration:underline;">View Current PDF</a>
                </div>
            <% } %>
            <input type="file" name="pdf" accept="application/pdf">
            <small>Upload new to replace existing PDF.</small>
        </div>

        <div class="form-group">
            <label>Description</label>
            <textarea id="description" name="description"><%- variant.description || '' %></textarea>
        </div>

        <!-- PLC We Offer Section -->
        <div class="section-header" style="margin-top:30px;">
            <h3>PLC We Offer (Sub-variants)</h3>
        </div>

        <div class="form-group">
            <div id="plc-items"></div>
            <button type="button" class="btn btn-secondary" style="margin-top:8px;" onclick="addPlcItem()">
                <i class="fa-solid fa-plus"></i> Add Sub-variant
            </button>
        </div>

        <div class="form-actions">
            <a href="/associate-variants" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary">Update Variant</button>
        </div>
    </form>
</div>

<!-- jQuery -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<!-- Summernote CSS -->
<link href="https://cdn.jsdelivr.net/npm/summernote@0.9.0/dist/summernote-lite.min.css" rel="stylesheet">
<!-- Summernote JS -->
<script src="https://cdn.jsdelivr.net/npm/summernote@0.9.0/dist/summernote-lite.min.js"></script>

<style>
    .plc-card {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 16px;
        margin-bottom: 14px;
    }
    .plc-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
    }
    .plc-header span {
        font-weight: 600;
        color: var(--text-primary);
    }
    .plc-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }
    .plc-card label {
        font-size: 13px;
        font-weight: 600;
        display: block;
        margin-bottom: 4px;
    }
    .plc-card input {
        width: 100%;
        padding: 8px 12px;
        border: 1px solid #ddd;
        border-radius: 6px;
        font-family: inherit;
        font-size: 14px;
        box-sizing: border-box;
    }
</style>

<script>
    $(document).ready(function () {
        $("#description").summernote({
            height: 250,
            placeholder: "Enter variant description...",
            toolbar: [
                ['style', ['style']],
                ['font', ['bold', 'italic', 'underline', 'clear']],
                ['fontsize', ['fontsize']],
                ['color', ['color']],
                ['para', ['ul', 'ol', 'paragraph']],
                ['insert', ['link', 'picture', 'table']],
                ['view', ['fullscreen', 'codeview']]
            ]
        });

        // Pre-load existing PLCs
        <% plcs.forEach((plc, i) => { %>
            addPlcItem(
                '<%= (plc.title || "").replace(/'/g, "\\'") %>',
                '<%= plc.image || "" %>'
            );
        <% }) %>
    });

    let plcCount = 0;
    function addPlcItem(title = '', existingImg = '') {
        const container = document.getElementById('plc-items');
        const idx = plcCount++;
        const card = document.createElement('div');
        card.className = 'plc-card';
        card.innerHTML = `
            <div class="plc-header">
                <span>Sub-variant #${idx + 1}</span>
                <button type="button" class="btn btn-sm btn-danger" onclick="this.closest('.plc-card').remove()">
                    <i class="fa-solid fa-trash"></i> Remove
                </button>
            </div>
            <div class="plc-row">
                <div>
                    <label>Title</label>
                    <input type="text" name="plc_title[]" value="${title}" placeholder="e.g. AS Series PLC" required>
                </div>
                <div>
                    <label>Image</label>
                    ${existingImg ? `
                        <div style="margin-bottom:4px;">
                            <img src="${existingImg}" height="40" style="border-radius:4px;border:1px solid #ddd;">
                        </div>
                    ` : ''}
                    <input type="file" name="plc_image_${idx}" accept="image/*">
                    <input type="hidden" name="existing_plc_image[]" value="${existingImg}">
                </div>
            </div>
        `;
        container.appendChild(card);
    }
</script>

<%- include('../../layout/footer') %>
