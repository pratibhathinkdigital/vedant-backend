<%- include('../../layout/header') %>

<div class="dashboard-header-banner">
    <div class="banner-welcome-text">
        <h1>Add Testimonial</h1>
        <p>Add customer feedback and review to show on the website.</p>
    </div>

    <div class="banner-actions">
        <a href="/testimonials" class="btn btn-secondary">
            <i class="fa-solid fa-arrow-left"></i>
            Back to Testimonials
        </a>
    </div>
</div>

<div class="table-container" style="max-width:800px; margin:20px 0;">
    <div class="section-header">
        <h3>Testimonial Details</h3>
    </div>
    <form action="/testimonials/store" method="POST" class="form-wrapper">
        <div class="form-group">
            <label for="name">Customer Name</label>
            <input type="text" id="name" name="name" class="form-control" placeholder="e.g. John Doe" required>
        </div>

        <div class="form-group">
            <label for="designation">Designation / Role</label>
            <input type="text" id="designation" name="designation" class="form-control" placeholder="e.g. CEO at TechCorp" required>
        </div>

        <div class="form-group">
            <label for="description">Testimonial / Review</label>
            <textarea id="description" name="description" class="form-control" rows="5" placeholder="Write customer feedback here..." required></textarea>
        </div>

        <div class="form-actions">
            <a href="/testimonials" class="btn btn-secondary">
                Cancel
            </a>
            <button type="submit" class="btn btn-primary">
                Save Testimonial
            </button>
        </div>
    </form>
</div>

<%- include('../../layout/footer') %>