<%- include('../../layout/header') %>

<div class="dashboard-header-banner">
    <div class="banner-welcome-text">
        <h1>Categories</h1>
        <p>Manage product taxonomy, slugs, and classifications.</p>
    </div>
    <div class="banner-actions">
        <a href="/categories/create" class="btn btn-primary">
            <i class="fa-solid fa-plus"></i> Add New Category
        </a>
    </div>
</div>

<div class="table-container" style="width: 100%; margin-top: 20px;">
    <div class="section-header">
        <h3>All Categories</h3>
        <div class="search-box" style="width: 250px;">
            <i class="fa-solid fa-magnifying-glass search-icon"></i>
            <input type="text" placeholder="Filter categories..." id="table-search">
        </div>
    </div>
    
    <div class="table-responsive">
        <table>
            <thead>
                <tr>
                    <th style="width: 80px;">ID</th>
                    <th>Image</th>
                    <th>Category Name</th>
                    <th>Slug</th>
                    <th>Description</th>
                    <th>Status</th>
                    <th>Created At</th>
                    <th style="text-align: right; width: 150px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                <% if(categories.length > 0) { %>
                    <% categories.forEach(cat => { %>
                        <tr>
                            <td class="tx-id">#<%= cat.id %></td>
                            <td>
                                <% if (cat.image) { %>
                                    <img src="<%= cat.image %>" alt="<%= cat.name %>" style="width: 40px; height: 40px; border-radius: 8px; object-fit: cover; border: 1px solid var(--glass-border);">
                                <% } else { %>
                                    <div class="avatar-fallback" style="width: 40px; height: 40px; border-radius: 8px; background: var(--accent-glow); color: var(--accent-color);">
                                        <i class="fa-solid fa-tags" style="font-size: 14px;"></i>
                                    </div>
                                <% } %>
                            </td>
                            <td style="font-weight: 600;"><%= cat.name %></td>
                            <td><span class="badge-type"><%= cat.slug %></span></td>
                            <td style="color: var(--text-secondary); max-width: 250px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                <%= cat.description || 'No description provided' %>
                            </td>
                            <td>
                                <span class="badge-status <%= cat.status.toLowerCase() %>">
                                    <%= cat.status %>
                                </span>
                            </td>
                            <td><%= cat.createdAt %></td>
                            <td style="text-align: right;">
                                <a href="/categories/edit/<%= cat.id %>" class="btn btn-sm btn-secondary" style="margin-right: 6px; padding: 6px 10px;" title="Edit">
                                    <i class="fa-regular fa-pen-to-square" style="color: var(--accent-color);"></i>
                                </a>
                                <a href="/categories/delete/<%= cat.id %>" class="btn btn-sm btn-secondary" style="padding: 6px 10px;" title="Delete" onclick="return confirm('Are you sure you want to delete this category?')">
                                    <i class="fa-regular fa-trash-can" style="color: var(--danger);"></i>
                                </a>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="7" style="text-align: center; padding: 30px; color: var(--text-muted);">
                            No categories found. Click "Add New Category" to create one.
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<script>
    // Search / Filter table
    const searchInput = document.getElementById('table-search');
    if(searchInput) {
        searchInput.addEventListener('keyup', function() {
            const filter = this.value.toLowerCase();
            const rows = document.querySelectorAll('table tbody tr');
            
            rows.forEach(row => {
                const nameCell = row.cells[1];
                const slugCell = row.cells[2];
                if (nameCell || slugCell) {
                    const nameText = nameCell.textContent.toLowerCase();
                    const slugText = slugCell.textContent.toLowerCase();
                    if (nameText.includes(filter) || slugText.includes(filter)) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                }
            });
        });
    }
</script>

<%- include('../../layout/footer') %>
