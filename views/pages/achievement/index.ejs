<%- include('../../layout/header') %>

    <div class="dashboard-header-banner">
        <div class="banner-welcome-text">
            <h1>Achievements</h1>
            <p>Manage achievement images and descriptions.</p>
        </div>

        <div class="banner-actions">
            <a href="/achievements/create" class="btn btn-primary">
                <i class="fa-solid fa-plus"></i>
                Add Achievement
            </a>
        </div>
    </div>

    <div class="table-container" style="width:100%; margin-top:20px;">

        <div class="section-header">

            <h3>All Achievements</h3>

            <div class="search-box" style="width:250px;">
                <i class="fa-solid fa-magnifying-glass search-icon"></i>
                <input
                    type="text"
                    id="table-search"
                    placeholder="Search Achievement...">
            </div>

        </div>

        <div class="table-responsive">

            <table>

                <thead>
                    <tr>
                        <th style="width:80px;">ID</th>
                        <th style="width:120px;">Image</th>
                        <th>Description</th>
                        <th style="width:170px;text-align:right;">Actions</th>
                    </tr>
                </thead>

                <tbody>

                    <% if(achievements.length > 0){ %>

                        <% achievements.forEach(achievement => { %>

                            <tr>

                                <td>#<%= achievement.id %></td>

                                <td>
                                    <% if(achievement.image){ %>
                                        <img
                                            src="<%= achievement.image %>"
                                            alt="Achievement"
                                            style="width:80px;height:50px;object-fit:cover;border-radius:8px;">
                                    <% } else { %>
                                        <span>No Image</span>
                                    <% } %>
                                </td>

                                <td style="max-width:300px;">
                                    <%= achievement.description %>
                                </td>

                                <td style="text-align:right;">

                                    <a
                                        href="/achievements/edit/<%= achievement.id %>"
                                        class="btn btn-sm btn-secondary"
                                        style="margin-right:5px;">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>

                                    <a
                                        href="/achievements/delete/<%= achievement.id %>"
                                        class="btn btn-sm btn-danger"
                                        onclick="return confirm('Are you sure you want to delete this achievement?')">
                                        <i class="fa-solid fa-trash"></i>
                                    </a>

                                </td>

                            </tr>

                        <% }) %>

                    <% } else { %>

                        <tr>
                            <td colspan="4" style="text-align:center;padding:30px;">
                                No Achievement Found
                            </td>
                        </tr>

                    <% } %>

                </tbody>

            </table>

        </div>

    </div>

    <script>

    const search = document.getElementById("table-search");

    search.addEventListener("keyup", function(){

        const value = this.value.toLowerCase();
        const rows = document.querySelectorAll("tbody tr");

        rows.forEach(row => {
            const text = row.innerText.toLowerCase();
            row.style.display = text.includes(value) ? "" : "none";
        });

    });

    </script>

<%- include('../../layout/footer') %>
