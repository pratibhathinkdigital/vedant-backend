<%- include('../../layout/header') %>

    <div class="dashboard-header-banner">
        <div class="banner-welcome-text">
            <h1>Edit Achievement</h1>
            <p>Update achievement image and description.</p>
        </div>

        <div class="banner-actions">
            <a href="/achievements" class="btn btn-secondary">
                <i class="fa-solid fa-arrow-left"></i>
                Back to Achievements
            </a>
        </div>
    </div>

    <div class="table-container" style="max-width:900px; margin:20px 0;">

        <div class="section-header">
            <h3>Edit Achievement</h3>
        </div>

        <form action="/achievements/update/<%= achievement.id %>" method="POST" enctype="multipart/form-data" class="form-wrapper">

            <!-- Current Image -->
            <div class="form-group">

                <label>Current Achievement Image</label>

                <% if(achievement.image){ %>
                    <div style="margin-bottom:15px;">
                        <img id="preview" src="<%= achievement.image %>" style="
                            width:250px;
                            border-radius:10px;
                            border:1px solid #ddd;
                        ">
                    </div>
                <% } else { %>
                    <img id="preview" src="" style="
                        display:none;
                        width:250px;
                        border-radius:10px;
                        border:1px solid #ddd;
                    ">
                <% } %>

            </div>

            <!-- Change Image -->
            <div class="form-group">
                <label>Change Achievement Image</label>
                <input type="file" name="image" class="form-control" accept="image/*">
                <small>Leave empty to keep the current image.</small>
            </div>

            <!-- Description -->
            <div class="form-group">
                <label>Description</label>
                <textarea
                    name="description"
                    class="form-control"
                    rows="4"
                    required><%= achievement.description %></textarea>
            </div>

            <!-- Buttons -->
            <div class="form-actions">
                <a href="/achievements" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">Update Achievement</button>
            </div>

        </form>

    </div>

    <script>

        const imageInput = document.querySelector('input[name="image"]');
        const preview = document.getElementById("preview");

        imageInput.addEventListener("change", function () {
            if (this.files && this.files[0]) {
                preview.src = URL.createObjectURL(this.files[0]);
                preview.style.display = "block";
            }
        });

    </script>

<%- include('../../layout/footer') %>
