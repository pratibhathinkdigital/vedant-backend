<%- include('../../layout/header') %>

    <div class="dashboard-header-banner">
        <div class="banner-welcome-text">
            <h1>Offerings</h1>
            <p>Manage offering images.</p>
        </div>

        <div class="banner-actions">
            <a href="/offerings/create" class="btn btn-primary">
                <i class="fa-solid fa-plus"></i>
                Add Offering
            </a>
        </div>
    </div>

    <div class="table-container" style="width:100%; margin-top:20px;">

        <div class="section-header">

            <h3>All Offerings</h3>

            <div class="search-box" style="width:250px;">
                <i class="fa-solid fa-magnifying-glass search-icon"></i>
                <input
                    type="text"
                    id="table-search"
                    placeholder="Search Offering...">
            </div>

        </div>

        <div class="table-responsive">

            <table>

                <thead>

                    <tr>
                        <th style="width:80px;">ID</th>
                        <th>Image</th>
                        <th style="width:170px;text-align:right;">Actions</th>
                    </tr>

                </thead>

                <tbody>

                    <% if(offerings.length > 0){ %>

                        <% offerings.forEach(offering => { %>

                            <tr>

                                <td>#<%= offering.id %></td>

                                <td>

                                    <% if(offering.image){ %>

                                        <img
                                            src="<%= offering.image %>"
                                            alt="Offering Image"
                                            style="width:80px;height:50px;object-fit:cover;border-radius:8px;">

                                    <% } else { %>

                                        <span>No Image</span>

                                    <% } %>

                                </td>

                                <td style="text-align:right;">

                                    <a
                                        href="/offerings/edit/<%= offering.id %>"
                                        class="btn btn-sm btn-secondary"
                                        style="margin-right:5px;">

                                        <i class="fa-solid fa-pen"></i>

                                    </a>

                                    <a
                                        href="/offerings/delete/<%= offering.id %>"
                                        class="btn btn-sm btn-danger"
                                        onclick="return confirm('Are you sure you want to delete this offering?')">

                                        <i class="fa-solid fa-trash"></i>

                                    </a>

                                </td>

                            </tr>

                        <% }) %>

                    <% } else { %>

                        <tr>

                            <td colspan="3" style="text-align:center;padding:30px;">

                                No Offering Found

                            </td>

                        </tr>

                    <% } %>

                </tbody>

            </table>

        </div>

    </div>

    <script>

    const search = document.getElementById("table-search");

    search.addEventListener("keyup", function(){

        const value = this.value.toLowerCase();

        const rows = document.querySelectorAll("tbody tr");

        rows.forEach(row => {

            const text = row.innerText.toLowerCase();

            row.style.display = text.includes(value)
                ? ""
                : "none";

        });

    });

    </script>

<%- include('../../layout/footer') %>
