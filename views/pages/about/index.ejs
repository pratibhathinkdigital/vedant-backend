<%- include('../../layout/header') %>

    <div class="dashboard-header-banner">
        <div class="banner-welcome-text">
            <h1>About</h1>
            <p>Manage about section images.</p>
        </div>

        <div class="banner-actions">
            <a href="/about/create" class="btn btn-primary">
                <i class="fa-solid fa-plus"></i>
                Add About Image
            </a>
        </div>
    </div>

    <div class="table-container" style="width:100%; margin-top:20px;">

        <div class="section-header">

            <h3>All About Images</h3>

            <div class="search-box" style="width:250px;">
                <i class="fa-solid fa-magnifying-glass search-icon"></i>
                <input type="text" id="table-search" placeholder="Search...">
            </div>

        </div>

        <div class="table-responsive">

            <table>

                <thead>
                    <tr>
                        <th style="width:80px;">ID</th>
                        <th>Image</th>
                        <th style="width:170px;text-align:right;">Actions</th>
                    </tr>
                </thead>

                <tbody>

                    <% if(abouts.length > 0){ %>

                        <% abouts.forEach(about => { %>

                            <tr>

                                <td>#<%= about.id %></td>

                                <td>
                                    <% if(about.image){ %>
                                        <img
                                            src="<%= about.image %>"
                                            alt="About Image"
                                            style="width:80px;height:50px;object-fit:cover;border-radius:8px;">
                                    <% } else { %>
                                        <span>No Image</span>
                                    <% } %>
                                </td>

                                <td style="text-align:right;">

                                    <a
                                        href="/about/edit/<%= about.id %>"
                                        class="btn btn-sm btn-secondary"
                                        style="margin-right:5px;">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>

                                    <a
                                        href="/about/delete/<%= about.id %>"
                                        class="btn btn-sm btn-danger"
                                        onclick="return confirm('Are you sure you want to delete this image?')">
                                        <i class="fa-solid fa-trash"></i>
                                    </a>

                                </td>

                            </tr>

                        <% }) %>

                    <% } else { %>

                        <tr>
                            <td colspan="3" style="text-align:center;padding:30px;">
                                No About Image Found
                            </td>
                        </tr>

                    <% } %>

                </tbody>

            </table>

        </div>

    </div>

    <script>

    const search = document.getElementById("table-search");

    search.addEventListener("keyup", function(){
        const value = this.value.toLowerCase();
        const rows = document.querySelectorAll("tbody tr");
        rows.forEach(row => {
            const text = row.innerText.toLowerCase();
            row.style.display = text.includes(value) ? "" : "none";
        });
    });

    </script>

<%- include('../../layout/footer') %>
