<%- include('../../layout/header') %>

<div class="dashboard-header-banner">
    <div class="banner-welcome-text">
        <h1>Add Insta Link</h1>
        <p>Add an Instagram link to show on the website.</p>
    </div>

    <div class="banner-actions">
        <a href="/instalinks" class="btn btn-secondary">
            <i class="fa-solid fa-arrow-left"></i>
            Back to Insta Links
        </a>
    </div>
</div>

<div class="table-container" style="max-width:800px; margin:20px 0;">
    <div class="section-header">
        <h3>Insta Link Details</h3>
    </div>
    <form action="/instalinks/store" method="POST" class="form-wrapper">
        <div class="form-group">
            <label for="link">Instagram Link</label>
            <input type="url" id="link" name="link" class="form-control" placeholder="e.g. https://www.instagram.com/username" required>
        </div>

        <div class="form-actions">
            <a href="/instalinks" class="btn btn-secondary">
                Cancel
            </a>
            <button type="submit" class="btn btn-primary">
                Save Insta Link
            </button>
        </div>
    </form>
</div>

<%- include('../../layout/footer') %>
