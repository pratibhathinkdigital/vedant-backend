<%- include('../../layout/header') %>

<div class="dashboard-header-banner">
    <div class="banner-welcome-text">
        <h1>Insta Links</h1>
        <p>Manage Instagram links shown on the website.</p>
    </div>

    <div class="banner-actions">
        <a href="/instalinks/create" class="btn btn-primary">
            <i class="fa-solid fa-plus"></i>
            Add Insta Link
        </a>
    </div>
</div>

<div class="table-container" style="width:100%; margin-top:20px;">

    <div class="section-header">
        <h3>All Insta Links</h3>

        <div class="search-box" style="width:250px;">
            <i class="fa-solid fa-magnifying-glass search-icon"></i>
            <input
                type="text"
                id="table-search"
                placeholder="Search Link...">
        </div>
    </div>

    <div class="table-responsive">
        <table>
            <thead>
                <tr>
                    <th style="width:80px;">ID</th>
                    <th>Instagram Link</th>
                    <th style="width:140px;text-align:right;">Actions</th>
                </tr>
            </thead>

            <tbody>
                <% if(instalinks && instalinks.length > 0){ %>
                    <% instalinks.forEach(item => { %>
                        <tr>
                            <td class="tx-id">#<%= item.id %></td>
                            <td>
                                <a href="<%= item.link %>" target="_blank" style="color: var(--accent-color);">
                                    <%= item.link %>
                                </a>
                            </td>
                            <td style="text-align:right;">
                                <a
                                    href="/instalinks/edit/<%= item.id %>"
                                    class="btn btn-sm btn-secondary"
                                    style="margin-right:5px; padding: 6px 10px;"
                                    title="Edit">
                                    <i class="fa-regular fa-pen-to-square" style="color: var(--accent-color);"></i>
                                </a>
                                <a
                                    href="/instalinks/delete/<%= item.id %>"
                                    class="btn btn-sm btn-secondary"
                                    style="padding: 6px 10px;"
                                    title="Delete"
                                    onclick="return confirm('Are you sure you want to delete this insta link?')">
                                    <i class="fa-regular fa-trash-can" style="color: var(--danger);"></i>
                                </a>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="3" style="text-align:center;padding:30px;color: var(--text-muted);">
                            No Insta Links Found. Click "Add Insta Link" to create one.
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<script>
const search = document.getElementById("table-search");
if(search) {
    search.addEventListener("keyup", function(){
        const value = this.value.toLowerCase();
        const rows = document.querySelectorAll("tbody tr");
        rows.forEach(row => {
            const text = row.innerText.toLowerCase();
            row.style.display = text.includes(value) ? "" : "none";
        });
    });
}
</script>

<%- include('../../layout/footer') %>
