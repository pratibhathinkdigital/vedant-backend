<%- include('../../layout/header') %>

<div class="dashboard-header-banner">
    <div class="banner-welcome-text">
        <h1>Associate Categories</h1>
        <p>Manage categories for our associates.</p>
    </div>

    <div class="banner-actions">
        <a href="/associate-categories/create" class="btn btn-primary">
            <i class="fa-solid fa-plus"></i> Add Category
        </a>
    </div>
</div>

<div class="table-container" style="width:100%; margin-top:20px;">

    <div class="section-header">
        <h3>All Associate Categories</h3>
    </div>

    <div class="table-responsive">
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Status</th>
                    <th>Created At</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% if(categories && categories.length > 0) { %>
                    <% categories.forEach(category => { %>
                        <tr>
                            <td><%= category.id %></td>
                            <td><strong><%= category.name %></strong></td>
                            <td>
                                <% if(category.status === 'Active') { %>
                                    <span class="status-badge status-active">Active</span>
                                <% } else { %>
                                    <span class="status-badge status-inactive">Inactive</span>
                                <% } %>
                            </td>
                            <td><%= new Date(category.createdAt).toLocaleDateString() %></td>
                            <td class="action-buttons">
                                <a href="/associate-categories/edit/<%= category.id %>" class="btn-icon btn-edit" title="Edit">
                                    <i class="fa-solid fa-pen"></i>
                                </a>
                                <a href="/associate-categories/delete/<%= category.id %>" class="btn-icon btn-delete" title="Delete" onclick="return confirm('Are you sure you want to delete this category?');">
                                    <i class="fa-solid fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="5" style="text-align:center;padding:30px;">
                            No Associate Categories Found
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<style>
    .status-badge {
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 12px;
        font-weight: 600;
        color: #fff;
    }
    .status-active { background: #10b981; }
    .status-inactive { background: #ef4444; }
    .btn-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        border-radius: 6px;
        margin-right: 6px;
        color: #fff;
        text-decoration: none;
    }
    .btn-edit { background: #f59e0b; }
    .btn-delete { background: #ef4444; }
</style>

<%- include('../../layout/footer') %>
