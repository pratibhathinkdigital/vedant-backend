<%- include('../../layout/header') %>

    <div class="dashboard-header-banner">
        <div class="banner-welcome-text">
            <h1>Edit Banner</h1>
            <p>Update banner details.</p>
        </div>

        <div class="banner-actions">
            <a href="/banners" class="btn btn-secondary">
                <i class="fa-solid fa-arrow-left"></i>
                Back to Banners
            </a>
        </div>
    </div>

    <div class="table-container" style="max-width:900px; margin:20px 0;">

        <div class="section-header">
            <h3>Edit Banner</h3>
        </div>

        <form action="/banners/update/<%= banner.id %>" method="POST" enctype="multipart/form-data"
            class="form-wrapper">



            <!-- Current Image -->
            <div class="form-group">

                <label>Current Banner Image</label>

                <% if(banner.image){ %>

                    <div style="margin-bottom:15px;">

                        <img id="preview" src="<%= banner.image %>" style="
                            width:250px;
                            border-radius:10px;
                            border:1px solid #ddd;
                        ">

                    </div>

                    <% } else { %>

                        <img id="preview" src="" style="
                        display:none;
                        width:250px;
                        border-radius:10px;
                        border:1px solid #ddd;
                    ">

                        <% } %>

            </div>

            <!-- Change Image -->
            <div class="form-group">

                <label>Change Banner Image</label>

                <input type="file" name="image" class="form-control" accept="image/*">

                <small>
                    Leave empty to keep the current image.
                </small>

            </div>

            <!-- Buttons -->
            <div class="form-actions">

                <a href="/banners" class="btn btn-secondary">
                    Cancel
                </a>

                <button type="submit" class="btn btn-primary">

                    Update Banner

                </button>

            </div>

        </form>

    </div>

    <script>

        const imageInput = document.querySelector('input[name="image"]');
        const preview = document.getElementById("preview");

        imageInput.addEventListener("change", function () {

            if (this.files && this.files[0]) {

                preview.src = URL.createObjectURL(this.files[0]);
                preview.style.display = "block";

            }

        });

    </script>

    <%- include('../../layout/footer') %>