<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/dashboard.css">
</head>

<body>
    <div class="app-container">
        <!-- Sidebar -->
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-brand">
                <img src="/img/vedant.png" alt="Vedant Logo" style="max-height: 40px; max-width: 100%; object-fit: contain;">
            </div>

            <nav class="sidebar-menu">
                <p class="menu-label">Main Menu</p>
                <ul>
                    <li class="<%= title.includes('Dashboard') ? 'active' : '' %>">
                        <a href="/dashboard">
                            <i class="fa-solid fa-chart-pie"></i>
                            <span>Dashboard</span>
                        </a>
                    </li>
                    <li class="<%= title.includes('Banner') ? 'active' : '' %>">
                        <a href="/banners">
                            <i class="fa-solid fa-tags"></i>
                            <span>Banner</span>
                        </a>
                    </li>
                    <li class="<%= title.includes('Category') && !title.includes('Associate') ? 'active' : '' %>">
                        <a href="/categories">
                            <i class="fa-solid fa-layer-group"></i>
                            <span>Category</span>
                        </a>
                    </li>
                    <li class="<%= title.includes('Client') ? 'active' : '' %>">
                        <a href="/clients">
                            <i class="fa-solid fa-user-tie"></i>
                            <span>Client</span>
                        </a>
                    </li>
                    <li class="<%= title.includes('Achievement') ? 'active' : '' %>">
                        <a href="/achievements">
                            <i class="fa-solid fa-trophy"></i>
                            <span>Achievement</span>
                        </a>
                    </li>
                    <li class="<%= title.includes('About') ? 'active' : '' %>">
                        <a href="/about">
                            <i class="fa-solid fa-circle-info"></i>
                            <span>About</span>
                        </a>
                    </li>
                    <li class="<%= title.includes('Product') || title.includes('Manufacture') ? 'active' : '' %>">
                        <a href="/products">
                            <i class="fa-solid fa-box"></i>
                            <span>We Manufacture</span>
                        </a>
                    </li>
                    <li class="<%= title.includes('Blog') || title.includes('Gallery') ? 'active' : '' %>">
                        <a href="/gallery">
                            <i class="fa-solid fa-newspaper"></i>
                            <span>Blog</span>
                        </a>
                    </li>
                    <li class="<%= title.includes('Associate Category') ? 'active' : '' %>">
                        <a href="/associate-categories">
                            <i class="fa-solid fa-sitemap"></i>
                            <span>Associate Category</span>
                        </a>
                    </li>
                    <li class="<%= title.includes('Associate Variant') ? 'active' : '' %>">
                        <a href="/associate-variants">
                            <i class="fa-solid fa-list-check"></i>
                            <span>Associate Variant</span>
                        </a>
                    </li>
                    <li class="<%= (title.includes('Case Study') || title.includes('Project')) && !title.includes('IProject') ? 'active' : '' %>">
                        <a href="/projects">
                            <i class="fa-solid fa-folder-open"></i>
                            <span>Case Study</span>
                        </a>
                    </li>
                    <li class="<%= title.includes('Inquir') ? 'active' : '' %>">
                        <a href="/inquiries">
                            <i class="fa-solid fa-envelope-open-text"></i>
                            <span>Contact Inquiries</span>
                        </a>
                    </li>
                </ul> 
            </nav>

            <div class="sidebar-footer">
                <div class="user-profile">
                    <img src="<%= user.avatar %>" alt="Avatar" class="avatar">
                    <div class="user-info">
                        <p class="user-name">
                            <%= user.name %>
                        </p>
                        <p class="user-role">
                            <%= user.role %>
                        </p>
                    </div>
                </div>
                <a href="/admin/logout" class="logout-btn" title="Logout">
                    <i class="fa-solid fa-right-from-bracket"></i>
                    <span>Logout</span>
                </a>
            </div>
        </aside>

        <!-- Main Content Area -->
        <div class="main-wrapper">
            <!-- Top Navbar -->
            <header class="top-navbar">
                <div class="navbar-left">
                    <button class="toggle-sidebar-btn" id="toggle-sidebar">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                    <div class="search-box">
                        <i class="fa-solid fa-magnifying-glass search-icon"></i>
                        <input type="text" placeholder="Search analytics, users, logs...">
                    </div>
                </div>

                <div class="navbar-right">
                    <!-- Theme Toggle -->
                    <button class="theme-toggle-btn" id="theme-toggle" title="Toggle Theme">
                        <i class="fa-solid fa-moon"></i>
                    </button>

                    <!-- Notifications -->
                    <div class="notification-dropdown">
                        <button class="nav-icon-btn" id="notification-btn">
                            <i class="fa-regular fa-bell"></i>
                            <span class="badge"></span>
                        </button>
                        <div class="dropdown-menu" id="notification-menu">
                            <div class="dropdown-header">
                                <h3>Notifications</h3>
                                <a href="#">Mark all read</a>
                            </div>
                            <div class="dropdown-items">
                                <% activities.forEach(act=> { %>
                                    <div class="dropdown-item">
                                        <div class="item-icon <%= act.type %>">
                                            <i class="fa-solid fa-<%= act.icon %>"></i>
                                        </div>
                                        <div class="item-content">
                                            <p class="item-text">
                                                <%= act.text %>
                                            </p>
                                            <span class="item-time">
                                                <%= act.time %>
                                            </span>
                                        </div>
                                    </div>
                                    <% }) %>
                            </div>
                        </div>
                    </div>

                    <!-- Divider -->
                    <div class="navbar-divider"></div>

                    <!-- User Actions -->
                    <div class="user-menu-wrapper">
                        <button class="user-menu-btn" id="user-menu-btn">
                            <img src="<%= user.avatar %>" alt="Avatar" class="avatar-small">
                            <span class="user-display-name">
                                <%= user.name %>
                            </span>
                            <i class="fa-solid fa-chevron-down caret-icon"></i>
                        </button>
                    </div>
                </div>
            </header>

            <!-- Content -->
            <main class="main-content">